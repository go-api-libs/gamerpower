func (v *{{.Name}}) unmarshalJSONMember(dec *jsontext.Decoder, name string) (bool, error) {
	switch name {
	{{- range .Fields }}{{ if and (not .Embedded) .JSONName }}
	case {{ printf "%q" .JSONName }}:
		return true, json.UnmarshalDecode(dec, &v.{{.Name}}, jsonOpts)
	{{- end }}{{ end }}
	}
	{{- range .Fields }}{{ if .Embedded }}

	if ok, err := v.{{.Type}}.unmarshalJSONMember(dec, name); ok || err != nil {
		return ok, err
	}
	{{- end }}{{ end }}

	return false, nil
}
