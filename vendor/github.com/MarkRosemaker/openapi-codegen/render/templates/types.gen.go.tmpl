	{{- end }}
	{{- with .UnixTimeMembers }}
	json.MarshalToFunc(jsonutil.TimeMarshalIntUnixFor({{ range $i, $m := . }}{{ if $i }}, {{ end }}{{ printf "%q" $m }}{{ end }})),
	{{- end }}
	{{- with .UnixDateMembers }}
	json.MarshalToFunc(jsonutil.DateMarshalIntUnixFor({{ range $i, $m := . }}{{ if $i }}, {{ end }}{{ printf "%q" $m }}{{ end }})),
	{{- end }}
	{{- with .BasicDateMembers }}
	json.MarshalToFunc(jsonutil.DateMarshalBasicFor({{ range $i, $m := . }}{{ if $i }}, {{ end }}{{ printf "%q" $m }}{{ end }})),
	{{- end }}
	{{- if .HasStringDateFields }}
	{{- /* last, so that it only writes a zero date the others leave: as null, not as "0000-00-00", which is no date */}}
	json.MarshalToFunc(jsonutil.DateMarshalZeroAsNull),
	{{- end }}
{{- end }}

{{- define "leaveOut" }}{{ $s := index . 0 }}{{ with index . 1 }}
	json.MarshalToFunc(func(enc *jsontext.Encoder, v {{ $s.Name }}) error {
		{{- range . }}
		v.{{ . }} = {{ $s.Name }}{}.{{ . }}
		{{- end }}
		{{- if $s.EncodesItself }}

		return v.MarshalJSONTo(enc)
		{{- else }}

		type plain {{ $s.Name }}
		return json.MarshalEncode(enc, plain(v))
		{{- end }}
	}),
{{- end }}{{ end }}
